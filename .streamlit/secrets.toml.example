# Copia questo file in secrets.toml e modifica con le tue credenziali
# ATTENZIONE: secrets.toml è nel .gitignore e non deve essere committato!

# Configurazione utenti
# Formato: username = "password"
[users]
admin = "password123"
user1 = "mypassword"
demo = "demo123"

# Nota: Su Streamlit Community Cloud, configura questi secrets tramite l'interfaccia web
# Settings > Secrets
